# Environment Variables Template
# Copy this file to .env and replace placeholder values with your real configuration.
# NEVER commit the real .env file into source control.

APP_ENV=development
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000

# Database Configuration
# Default to SQLite for zero-setup execution, or point to PostgreSQL
DATABASE_URL=sqlite:///./billing.db
# DATABASE_URL=postgresql://billing_user:billing_pass@localhost:5432/billing_db

# Stripe Configuration (Test Mode Only!)
# Must start with sk_test_... and whsec_...
STRIPE_SECRET_KEY=sk_test_placeholder_replace_with_test_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_with_webhook_secret

# AI Token Pricing Constants (Pinned per 1,000,000 tokens in micro-units: 1 USD = 1,000,000 micro-units)
# Standard Input: $2.50 / 1M = 2.5 micro-units / token
PRICE_STANDARD_INPUT_PER_1M_MICROS=2500000
# Cached Input: $0.625 / 1M = 0.625 micro-units / token (75% discount)
PRICE_CACHED_INPUT_PER_1M_MICROS=625000
# Standard Output: $10.00 / 1M = 10.0 micro-units / token
PRICE_OUTPUT_PER_1M_MICROS=10000000
# Reasoning tokens: billed at output rate ($10.00 / 1M)
PRICE_REASONING_PER_1M_MICROS=10000000
# Base API call charge: $0.0005 per call = 500 micro-units
PRICE_PER_API_CALL_MICROS=500

