# Kill switch: set false/0 to disable all LLM calls (returns 503)
LLM_ENABLED=true

# Force deterministic mock provider (no network). Eval uses this by default.
MOCK_LLM=1

# OpenAI-compatible API (used when MOCK_LLM=0 and LLM_ENABLED=true)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Resilience
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Cost logging (estimated USD; append-only JSON lines)
COST_LOG_PATH=logs/cost.jsonl
